#: Образец окружения продукта `realty`: копируется в `.env` рядом с композом — и этот файл ОБЯЗАТЕЛЕН.
#: Значения — литералами: файл читается и как текст (лончеры), и как env-файл (композ).
#: ❗ СВОЯ база продукта — `realty`: свой экземпляр postgres в этом же композе (`realty-db`). Векторная
#: база и база чекпойнтов поднимаются им же.
#:
#: Сюда НЕ кладутся (их задаёт развёртывание, а не `.env`):
#:   · `SESSIONS_DIR` — путь каталога сессий В КОНТЕЙНЕРЕ задаёт композ, на хосте — лончер;
#:   · `*_URL_HOST` — loopback-адреса хостового отката, их подставляет лончер;
#:   · `AGENT_ENV_FILES`, `REALTY_ENV`, `REALTY_BASE_ENV`, `REALTY_PY` — служебные ключи лончеров;
#:   · `VENDORS_FILE`, `PG_CONT`, `PG_USER`, `PG_DB` — служебные переопределения инструментов.

# --- Свои базы ---
#: База продукта: логин и пароль — свои, адрес живёт здесь, а не в общем окружении.
DB_URL=postgresql+asyncpg://realty:CHANGE_ME@realty-db:5432/realty
#: Пароль своего экземпляра postgres: его читает композ, создавая контейнер базы.
REALTY_DB_PASSWORD=CHANGE_ME
#: Векторная база RAG (поднимается композом). Пароль обязателен: без него контейнер не соберёт адрес.
VECTOR_DB_PASSWORD=CHANGE_ME
#: Чекпойнты графа напоминаний — своя база и свой адрес; пусто ⇒ граф отказывается подниматься.
GRAPH_DB_PASSWORD=CHANGE_ME

# --- Общая сеть платформы ---
#: Имя общей сети (`external: true`): в ней живут база, платформа и соседние продукты. Обязательно —
#: умолчания у композа нет, иначе проект подключился бы к случайно совпавшей сети.
#: Имя общей сети. В воркспейсе его задаёт ОБЩАЯ ОСНОВА (там же, где адрес платформы);
#: раскомментируйте и задайте своё, если проект стоит отдельным клоном.
# PLATFORM_NETWORK=platform-net

# --- Режим платформы и наблюдаемость ---
#: Значение — имя вендора из `lib/vendors.tsv`. Пусто ⇒ вендор по умолчанию (первый с `runtime`).
#: Ось наблюдаемости отдельно от оси рантайма; пусто ⇒ берётся `PLATFORM_VENDOR`.
#: Адрес приёма OTLP у того вендора, который принимает трассы; пусто ⇒ трассировки нет.
#: Приём спанов платформы и ключ с правом записи (пусто ⇒ берётся `PLATFORM_API_KEY`).
#: Привязка спана к агенту и ролям — атрибутами спана, не ресурса.
OTEL_WORKFLOW_ID=
OTEL_WORKFLOW_SLUG=
OTEL_AGENT_ID=
OTEL_ROLE_REALTOR_REVISION=
OTEL_ROLE_LISTING_REVISION=
#: Адрес API платформы. Ключ нужен для прав: у приёма — `EDIT_SPANS`, у ручек — `X-API-Key`.

# --- Telegram ---
#: MTProto (`my.telegram.org`): без пары api_id/api_hash бот не подключается.
#: Одиночный MTProto-прокси (если прямой маршрут недоступен) или массив прокси в `TELEGRAM_MT_PROXIES`.
#: Бот клиентов и чат менеджера; `TELEGRAM_OWNER_CHAT_ID` — адресат уведомлений владельцу.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
#: Контакт «запрос звонка» в ответе клиенту.
MANAGER_CONTACT=
#: Подпись кнопок: короче 16 символов — кнопки не подписываются.
#: Ключ бизнес-ручек HTTP API (`X-API-Key`).

# --- Адреса сервисов моделей (объявляет агент, не ядро) ---
#: Контейнер ходит по имени службы в общей сети; обязательные подстановки в композе (`:?`).
LLAMA_EMBED_URL=http://embed:8082/v1
LLAMA_EMBED_API_KEY=
LLAMA_EMBED_MODEL=embeddinggemma-2
LLAMA_EMBED_TIMEOUT_S=15
SOLVER_URL=http://solver:8083
SOLVER_API_KEY=
SOLVER_TIMEOUT_S=60
#: Порог лестницы решений: ниже него ход уходит в облако.
SOLVER_CONFIDENCE_THRESHOLD=0.75
#: Провайдер LLM для ролей своего рантайма (`AGENT_RUNTIME=own`).

# --- Агенты платформы (роли и их ревизии) ---
#: Диалог: slug агента, slug канала и ревизия, в которой включены его инструменты.
AGENT_BOT_DIALOG=realtor-bot
DIALOG_CONNECTION_SLUG=realtor
DIALOG_WORKFLOW_ID=
DIALOG_REVISION_ID=
#: Объявления: свой агент, свой канал, своя ревизия.
AGENT_BOT_LISTING=listing-writer
LISTING_CONNECTION_SLUG=listing-writer-conn
LISTING_WORKFLOW_ID=
LISTING_REVISION_ID=
#: Свой рантайм (`platform`|`own`|`auto`): `own` берёт промпт из файла агента.
#: Цены токенов — для пересчёта расхода в деньги (0 ⇒ цена неизвестна, а не «бесплатно»).
DIALOG_PRICE_IN_PER_1K_USD=0
DIALOG_PRICE_OUT_PER_1K_USD=0
LISTING_PRICE_IN_PER_1K_USD=0
LISTING_PRICE_OUT_PER_1K_USD=0

# --- Поведение бота и пределы ---
BRIDGE_BOT_MODE=live                    # live|paused|off
#: Локальное закрытие простых условий без вызова агента.
DIALOG_LADDER_ENABLED=0
#: Выборка по корпусу знаний.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.0
#: Лимиты генерации объявлений.
LISTINGS_MAX_PER_DAY=20
LISTINGS_MAX_PHOTO_MB=10

# --- Календарь визитов ---
#: Приватный iCal-адрес (содержит токен доступа): пусто — механизм выключен.
CALENDAR_ICS_URL=
CALENDAR_NOTIFY_AHEAD_H=24
CALENDAR_POLL_S=300
CALENDAR_AGENT_TEXT=True

# --- Напоминания о визите ---
VISIT_REMINDER_HOURS_BEFORE=20
VISIT_REMINDER_REPEAT_H=4
VISIT_REMINDER_MAX_REPEATS=2
VISIT_REMINDER_TICK_S=300
#: Доля уведомлений, отданных «лечению» (сравнение веток), в процентах.
VISIT_REMINDER_TREATMENT_SHARE=50

# --- MCP-листенер ---
MCP_ENABLED=True
MCP_PORT=8087
MCP_BIND_HOST=0.0.0.0

# --- Выгрузка персональных данных ---
#: Получатель GPG для шифрования выгрузки; пусто — выгрузка без шифрования не делается.
EXPORT_GPG_RECIPIENT=

#: ❗ Ключи с двумя потребителями (платформа, Telegram-доступ, LLM, OTLP, общая сеть, пароль
#: векторной базы) живут в ОБЩЕЙ ОСНОВЕ воркспейса — здесь их нет намеренно: пустое значение
#: в этом файле перекрыло бы основу (env_file читается в порядке «основа → проект»).
